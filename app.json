{
  "expo": {
    "name": "Message in a Bottle",
    "slug": "message-in-a-bottle",
    "version": "1.0.0-beta.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "messageinabottle",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.personal.messageinabottle",
      "buildNumber": "2",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Message in a Bottle uses Bluetooth GATT to exchange text messages with nearby phones, with no internet.",
        "NSBluetoothPeripheralUsageDescription": "Message in a Bottle advertises as a BLE peripheral so nearby phones can pick up and leave messages."
      }
    },
    "android": {
      "package": "dev.personal.messageinabottle",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#071018",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#071018"
        }
      ],
      "expo-dev-client",
      "./plugins/withWindowsCmake",
      [
        "munim-bluetooth",
        {
          "androidBluetoothPermissions": [
            "scan",
            "connect",
            "advertise"
          ],
          "bluetoothBackground": true,
          "multipeerServiceTypes": false,
          "bluetoothAlwaysUsageDescription": "Message in a Bottle uses Bluetooth GATT to exchange text messages with nearby phones, with no internet.",
          "bluetoothPeripheralUsageDescription": "Message in a Bottle advertises as a BLE peripheral so nearby phones can pick up and leave messages."
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Message in a Bottle uses the camera only to scan a UUID QR code for the whitelist.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
